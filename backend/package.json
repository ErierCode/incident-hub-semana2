{
  "name": "@incident-hub/backend",
  "version": "0.2.0",
  "private": true,
  "description": "API REST de IT Incident Hub",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.js",
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=../.env src/db/migrate.js",
    "lint": "eslint .",
    "build": "node scripts/check-syntax.js",
    "test": "jest --coverage",
    "test:ci": "jest --coverage --ci --reporters=default --reporters=jest-junit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "jest": "^30.0.0",
    "jest-junit": "^17.0.0",
    "pg-mem": "^3.0.5",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text-summary",
      "cobertura",
      "lcov"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/db/migrate.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 90,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml"
  }
}
